{
  "name": "@pixelvault/sdk",
  "version": "0.1.0",
  "description": "Integrate USDC-backed, refundable items from the PixelVault Solana program into a game",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@solana/kit": ">=8.3.0 <9"
  },
  "devDependencies": {
    "@solana/kit": "^8.3.0",
    "@types/node": "^22.0.0",
    "litesvm": "^1.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
